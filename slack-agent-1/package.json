{
  "name": "slack-agent-1",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "clean": "find lib bin test -name '*.js' -not -name 'jest.config.js' -delete; find lib bin test -name '*.d.ts' -delete; find lib bin test -name '*.js.map' -delete; rm -rf cdk.out",
    "clean:all": "npm run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "aws-cdk": "2.1142.0",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.5.0"
  }
}
